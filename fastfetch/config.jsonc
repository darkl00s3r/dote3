{
  "display": {
    "color": {
      "keys": "#ffffff"
    },
    "key": {
      "width": 11
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "#ebdbb2"
    },
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "width": 5,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 1,
      "bottom": 10
    }
  },
  "modules": [
    {
      "color": {
        "at": "#666666",
        "host": "#ff8a8a",
        "user": "#ff8a8a"
      },
      "type": ""
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": " 󰣇 OS",
      "keyColor": "#71b7ff",
      "type": "os"
    },
    {
      "key": " 󰌽 Kernel",
      "keyColor": "#d2a8ff",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": "  WM",
      "keyColor": "#ff8a8a",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": "  Shell",
      "keyColor": "#8ddb8c",
      "type": "shell"
    },
    {
      "key": " 󰔚 Uptime",
      "keyColor": "#d2b45f",
      "type": "uptime"
    },
    {
      "format": "{used} / {total}",
      "key": "  Ram",
      "keyColor": "#71b7ff",
      "type": "memory"
    },
    {
      "format": "{pretty-name}",
      "key": " 󰸱 Color",
      "symbol": "circle",
      "type": "colors"
    },
    "break",
    "break"
  ]
}